generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?          // ← make optional
  googleId  String?  @unique // ← add this
  role      Role     @default(CUSTOMER)
  profile   Profile?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  catProfiles    CatProfile[]
  diseasesCreated    Disease[]     @relation("DiseaseCreatedBy")
  diseasesApproved   Disease[]     @relation("DiseaseApprovedBy")
  medicinesCreated   Medicine[]    @relation("MedicineCreatedBy")
  medicinesApproved  Medicine[]    @relation("MedicineApprovedBy")
  flagsRaised        ContentFlag[] @relation("FlagsRaised")
  flagsResolved      ContentFlag[] @relation("FlagsResolved")
  diagnosesCreated   CatDiagnosis[] @relation("DiagnosisCreatedBy")
  emergencyGuidesCreated  EmergencyGuide[] @relation("EmergencyGuideCreatedBy")
  emergencyGuidesApproved EmergencyGuide[] @relation("EmergencyGuideApprovedBy")
  treatmentRecordsCreated CatTreatmentRecord[] @relation("TreatmentRecordCreatedBy")
  notifications Notification[] @relation("UserNotifications")
  availabilitySlots      VetAvailabilitySlot[] @relation("VetAvailabilitySlots")
  appointmentsAsOwner    Appointment[]         @relation("AppointmentsAsOwner")
  appointmentsAsVet      Appointment[]         @relation("AppointmentsAsVet")
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String?
  phone          String?
  clinicName     String?
  address        String?
  specialization String?
  avatar         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CatBreed {
  id                 String   @id @default(uuid())
  name               String   @unique
  origin             String
  description        String
  physicalAppearance String
  weightRange        String
  lifespan           String
  temperament        String[]
  personality        String
  imageUrls          String[]
  catProfiles        CatProfile[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Disease {
  id                  String            @id @default(uuid())
  name                String            @unique
  description         String
  causes              String[]
  symptoms            String[]
  severity            DiseasesSeverity  @default(MEDIUM)
  preventionMethods   String[]
  treatmentMethods    String[]
  recoveryPeriod      String
  imageUrl            String?
  diseaseMedicines    DiseaseMedicine[]
  relatedDiseasesFrom RelatedDisease[]  @relation("diseaseFrom")
  relatedDiseasesTo   RelatedDisease[]  @relation("diseaseTo")
  diseaseSymptoms     DiseaseSymptom[]
  diseaseTreatments   DiseaseTreatment[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  status        VerificationStatus @default(DRAFT)
  createdById   String?
  createdBy     User?    @relation("DiseaseCreatedBy", fields: [createdById], references: [id])
  approvedById  String?
  approvedBy    User?    @relation("DiseaseApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  flags         ContentFlag[]
  diseaseFoods        DiseaseFood[]      
  catDiagnoses        CatDiagnosis[] 
}

model Medicine {
  id                String            @id @default(uuid())
  name              String            @unique
  description       String
  dosage            String
  sideEffects       String[]
  usageInstructions String
  warnings          String[]
  manufacturer      String?
  imageUrl          String?
  diseaseMedicines  DiseaseMedicine[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  status        VerificationStatus @default(DRAFT)
  createdById   String?
  createdBy     User?    @relation("MedicineCreatedBy", fields: [createdById], references: [id])
  approvedById  String?
  approvedBy    User?    @relation("MedicineApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  flags         ContentFlag[]
}

model DiseaseMedicine {
  id          String    @id @default(uuid())
  diseaseId   String
  medicineId  String
  disease     Disease   @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  medicine    Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([diseaseId, medicineId])
}

model RelatedDisease {
  id            String   @id @default(uuid())
  diseaseFromId String
  diseaseToId   String
  diseaseFrom   Disease  @relation("diseaseFrom", fields: [diseaseFromId], references: [id], onDelete: Cascade)
  diseaseTo     Disease  @relation("diseaseTo", fields: [diseaseToId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([diseaseFromId, diseaseToId])
}

model Symptom {
  id               String            @id @default(uuid())
  name             String            @unique
  description      String
  affectedBodyAreas String[]
  commonality      SymptomCommonality @default(COMMON)
  onsetSpeed       SymptomOnsetSpeed  @default(ACUTE)
  notes            String?
  diseaseSymptoms  DiseaseSymptom[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model DiseaseSymptom {
  id        String   @id @default(uuid())
  diseaseId String
  symptomId String
  disease   Disease  @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  symptom   Symptom  @relation(fields: [symptomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([diseaseId, symptomId])
}

enum Role {
  VET
  CUSTOMER
}

enum DiseasesSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SymptomCommonality {
  RARE
  COMMON
  VERY_COMMON
}

enum SymptomOnsetSpeed {
  ACUTE
  SUBACUTE
  CHRONIC
}

enum VerificationStatus {
  DRAFT
  PENDING
  APPROVED
  FLAGGED
}

enum FlagContentType {
  DISEASE
  MEDICINE
  EMERGENCY_GUIDE
}

enum FlagStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum EmergencyUrgency {
  CRITICAL
  URGENT
}

model EmergencyGuide {
  id                 String             @id @default(uuid())
  title              String             @unique
  category           String
  urgency            EmergencyUrgency   @default(URGENT)
  summary            String
  emergencySymptoms  String[]
  firstAidSteps      String[]
  doNots             String[]
  whenToSeekVet      String
  imageUrl           String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  status        VerificationStatus @default(DRAFT)
  createdById   String?
  createdBy     User?     @relation("EmergencyGuideCreatedBy", fields: [createdById], references: [id])
  approvedById  String?
  approvedBy    User?     @relation("EmergencyGuideApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?

  flags         ContentFlag[]
}

model Treatment {
  id                 String               @id @default(uuid())
  name               String               @unique
  description        String
  contraindications  String[]
  vetNotes           String?
  estimatedDuration  String?
  estimatedCost      String?
  successRate        Float?
  imageUrl           String?
  steps              TreatmentStep[]
  diseaseTreatments  DiseaseTreatment[]
  catTreatmentRecords CatTreatmentRecord[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model TreatmentStep {
  id              String    @id @default(uuid())
  treatmentId     String
  treatment       Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  stepOrder       Int
  title           String
  description     String
  durationMinutes Int?
  createdAt       DateTime  @default(now())
}

model DiseaseTreatment {
  id          String    @id @default(uuid())
  diseaseId   String
  treatmentId String
  disease     Disease   @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([diseaseId, treatmentId])
}

model CatFood {
  id                   String          @id @default(uuid())
  name                 String          @unique
  brand                String
  category             FoodCategory
  foodType             FoodType
  description          String
  ingredients          String[]
  protein              Float?
  fat                  Float?
  fiber                Float?
  moisture             Float?
  calories             Float?
  ageMinMonths         Int?
  ageMaxMonths         Int?
  weightRange          String?
  allergens            String[]
  prescriptionRequired Boolean         @default(false)
  vetNotes             String?
  imageUrl             String?
  diseaseFoods         DiseaseFood[] 
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model DiseaseFood {
  id        String   @id @default(uuid())
  diseaseId String
  foodId    String
  disease   Disease  @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  food      CatFood  @relation(fields: [foodId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([diseaseId, foodId])
}

enum FoodCategory {
  KITTEN
  ADULT
  SENIOR
  PRESCRIPTION
}

enum FoodType {
  DRY
  WET
  SEMI_MOIST
  RAW
  SUPPLEMENT
}
model CatProfile {
  id                 String              @id @default(uuid())
  ownerId            String
  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  gender             CatGender
  birthDate          DateTime?
  ageYears           Int?
  ageMonths          Int?
  weightKg           Float?
  breedId            String?             // ← REPLACES breed String?
  breed              CatBreed?           @relation(fields: [breedId], references: [id])  // ← ADD
  color              String?
  notes              String?
  imageUrls          String[]
  vaccinations       Vaccination[]
  diagnoses          CatDiagnosis[]      // ← ADD
  healthNotes         HealthNote[]
  catTreatmentRecords CatTreatmentRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  appointments       Appointment[]
}

model Vaccination {
  id           String      @id @default(uuid())
  catProfileId String
  catProfile   CatProfile  @relation(fields: [catProfileId], references: [id], onDelete: Cascade)
  vaccineName  String
  dateGiven    DateTime
  nextDueDate  DateTime?
  veterinarian String?
  notes        String?
  createdAt    DateTime    @default(now())
}

model CatDiagnosis {
  id            String     @id @default(uuid())
  catProfileId  String
  catProfile    CatProfile @relation(fields: [catProfileId], references: [id], onDelete: Cascade)
  diseaseId     String
  disease       Disease    @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  diagnosedById String
  diagnosedBy   User       @relation("DiagnosisCreatedBy", fields: [diagnosedById], references: [id])
  diagnosedAt   DateTime   @default(now())
  notes         String?
  createdAt     DateTime   @default(now())

  @@unique([catProfileId, diseaseId])
}

enum CatGender {
  MALE
  FEMALE
  UNKNOWN
}

model ContentFlag {
  id             String          @id @default(uuid())
  contentType    FlagContentType
  contentId      String
  reason         String
  raisedById     String
  raisedBy       User            @relation("FlagsRaised", fields: [raisedById], references: [id])
  status         FlagStatus      @default(OPEN)
  resolvedById   String?
  resolvedBy     User?           @relation("FlagsResolved", fields: [resolvedById], references: [id])
  resolverNote   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emergencyGuide EmergencyGuide? @relation(fields: [contentId], references: [id], map: "flag_emergency_guide")
  disease        Disease?        @relation(fields: [contentId], references: [id], map: "flag_disease")
  medicine       Medicine?       @relation(fields: [contentId], references: [id], map: "flag_medicine")
}

model HealthNote {
  id           String     @id @default(uuid())
  catProfileId String
  catProfile   CatProfile @relation(fields: [catProfileId], references: [id], onDelete: Cascade)
  title        String?
  content      String
  noteDate     DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CatTreatmentRecord {
  id               String     @id @default(uuid())
  catProfileId     String
  catProfile       CatProfile @relation(fields: [catProfileId], references: [id], onDelete: Cascade)
  treatmentId      String
  treatment        Treatment  @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  administeredById String
  administeredBy   User       @relation("TreatmentRecordCreatedBy", fields: [administeredById], references: [id])
  administeredAt   DateTime   @default(now())
  notes            String?
  createdAt        DateTime   @default(now())
}

model Notification {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  contentType FlagContentType?
  contentId   String?
  read        Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@index([userId, read])
}

enum NotificationType {
  CONTENT_APPROVED
  CONTENT_FLAGGED
  APPOINTMENT_BOOKED       // ← ADD
  APPOINTMENT_CANCELLED    // ← ADD
  APPOINTMENT_COMPLETED 
}

model VetAvailabilitySlot {
  id          String       @id @default(uuid())
  vetId       String
  vet         User         @relation("VetAvailabilitySlots", fields: [vetId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime
  isBooked    Boolean      @default(false)
  blocked     Boolean      @default(false)  
  appointment Appointment?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([vetId, startTime])
}

model Appointment {
  id           String              @id @default(uuid())
  ownerId      String
  owner        User                @relation("AppointmentsAsOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  vetId        String
  vet          User                @relation("AppointmentsAsVet", fields: [vetId], references: [id], onDelete: Cascade)
  slotId       String              @unique
  slot         VetAvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  catProfileId String?
  catProfile   CatProfile?         @relation(fields: [catProfileId], references: [id], onDelete: SetNull)
  reason       String?
  status       AppointmentStatus   @default(CONFIRMED)
  cancelledBy  CancelledBy?
  cancelReason String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CancelledBy {
  OWNER
  VET
}