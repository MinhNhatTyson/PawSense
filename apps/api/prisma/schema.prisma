generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?          // ← make optional
  googleId  String?  @unique // ← add this
  role      Role     @default(CUSTOMER)
  profile   Profile?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String?
  phone          String?
  clinicName     String?
  address        String?
  specialization String?
  avatar         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CatBreed {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String
  characteristics String
  imageUrl        String?
  createdAt       DateTime @default(now())
}

model Disease {
  id                  String            @id @default(uuid())
  name                String            @unique
  description         String
  causes              String[]
  symptoms            String[]
  severity            DiseasesSeverity  @default(MEDIUM)
  preventionMethods   String[]
  treatmentMethods    String[]
  recoveryPeriod      String
  imageUrl            String?
  diseaseMedicines    DiseaseMedicine[]
  relatedDiseasesFrom RelatedDisease[]  @relation("diseaseFrom")
  relatedDiseasesTo   RelatedDisease[]  @relation("diseaseTo")
  diseaseSymptoms     DiseaseSymptom[]
  diseaseTreatments   DiseaseTreatment[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model Medicine {
  id                String            @id @default(uuid())
  name              String            @unique
  description       String
  dosage            String
  sideEffects       String[]
  usageInstructions String
  warnings          String[]
  manufacturer      String?
  imageUrl          String?
  diseaseMedicines  DiseaseMedicine[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model DiseaseMedicine {
  id          String    @id @default(uuid())
  diseaseId   String
  medicineId  String
  disease     Disease   @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  medicine    Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([diseaseId, medicineId])
}

model RelatedDisease {
  id            String   @id @default(uuid())
  diseaseFromId String
  diseaseToId   String
  diseaseFrom   Disease  @relation("diseaseFrom", fields: [diseaseFromId], references: [id], onDelete: Cascade)
  diseaseTo     Disease  @relation("diseaseTo", fields: [diseaseToId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([diseaseFromId, diseaseToId])
}

model Symptom {
  id               String            @id @default(uuid())
  name             String            @unique
  description      String
  affectedBodyAreas String[]
  commonality      SymptomCommonality @default(COMMON)
  onsetSpeed       SymptomOnsetSpeed  @default(ACUTE)
  notes            String?
  diseaseSymptoms  DiseaseSymptom[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model DiseaseSymptom {
  id        String   @id @default(uuid())
  diseaseId String
  symptomId String
  disease   Disease  @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  symptom   Symptom  @relation(fields: [symptomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([diseaseId, symptomId])
}

enum Role {
  VET
  CUSTOMER
}

enum DiseasesSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SymptomCommonality {
  RARE
  COMMON
  VERY_COMMON
}

enum SymptomOnsetSpeed {
  ACUTE
  SUBACUTE
  CHRONIC
}

model Treatment {
  id                 String               @id @default(uuid())
  name               String               @unique
  description        String
  contraindications  String[]
  vetNotes           String?
  estimatedDuration  String?
  estimatedCost      String?
  successRate        Float?
  imageUrl           String?
  steps              TreatmentStep[]
  diseaseTreatments  DiseaseTreatment[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model TreatmentStep {
  id              String    @id @default(uuid())
  treatmentId     String
  treatment       Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  stepOrder       Int
  title           String
  description     String
  durationMinutes Int?
  createdAt       DateTime  @default(now())
}

model DiseaseTreatment {
  id          String    @id @default(uuid())
  diseaseId   String
  treatmentId String
  disease     Disease   @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([diseaseId, treatmentId])
}