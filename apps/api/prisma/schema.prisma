generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  profile   Profile?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String?
  phone          String?
  clinicName     String?
  address        String?
  specialization String?
  avatar         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CatBreed {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String
  characteristics String
  imageUrl       String?
  createdAt      DateTime @default(now())
}

model Disease {
  id                  String           @id @default(uuid())
  name                String           @unique
  description         String
  causes              String[]
  symptoms            String[]
  severity            DiseasesSeverity @default(MEDIUM)
  preventionMethods   String[]
  treatmentMethods    String[]
  recoveryPeriod      String
  imageUrl            String?
  medicines           Medicine[]
  relatedDiseasesFrom RelatedDisease[] @relation("diseaseFrom")
  relatedDiseasesTo   RelatedDisease[] @relation("diseaseTo")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model Medicine {
  id        String    @id @default(uuid())
  name      String
  dosage    String
  diseaseId String
  disease   Disease   @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
}

model RelatedDisease {
  id           String   @id @default(uuid())
  diseaseFromId String
  diseaseToId  String
  diseaseFrom  Disease  @relation("diseaseFrom", fields: [diseaseFromId], references: [id], onDelete: Cascade)
  diseaseTo    Disease  @relation("diseaseTo", fields: [diseaseToId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([diseaseFromId, diseaseToId])
}

enum Role {
  VET
  CUSTOMER
}

enum DiseasesSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}