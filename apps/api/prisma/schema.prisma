generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  profile   Profile?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String?
  phone          String?
  clinicName     String?
  address        String?
  specialization String?
  avatar         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CatBreed {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String
  characteristics String
  imageUrl       String?
  createdAt      DateTime @default(now())
}

model Disease {
  id          String     @id @default(uuid())
  name        String     @unique
  symptoms    String[]
  description String
  cure        String
  medicines   Medicine[]
  createdAt   DateTime   @default(now())
}

model Medicine {
  id        String    @id @default(uuid())
  name      String
  dosage    String
  diseaseId String
  disease   Disease   @relation(fields: [diseaseId], references: [id])
}

enum Role {
  VET
  CUSTOMER
}