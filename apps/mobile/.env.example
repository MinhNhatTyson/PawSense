# API Configuration
# Set this to the API server URL (default: http://localhost:3000/api for local development)
# Copy this file to .env and adjust for your machine.
#
# Default works when running in a simulator/emulator on the same computer
# as the API server. When testing on a PHYSICAL DEVICE (e.g. scanning the
# Expo Go QR code from the desktop dashboard), this MUST be your
# development machine's LAN IP address, not "localhost".
EXPO_PUBLIC_API_URL=http://localhost:3000/api