generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
}

model CatBreed {
  id             String   @id @default(uuid())
  name           String   @unique
  description    String
  characteristics String
  imageUrl       String?
  createdAt      DateTime @default(now())
}

model Disease {
  id          String     @id @default(uuid())
  name        String     @unique
  symptoms    String[]
  description String
  cure        String
  medicines   Medicine[]
  createdAt   DateTime   @default(now())
}

model Medicine {
  id        String    @id @default(uuid())
  name      String
  dosage    String
  diseaseId String
  disease   Disease   @relation(fields: [diseaseId], references: [id])
}

enum Role {
  VET
  CUSTOMER
}